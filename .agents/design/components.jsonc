            "layout": {
              "padding": "0",
              "width": "fill",
              "height": 44
            },
            "margin": "0",
            "appearance": {
              "textStyle": "chatInput",
              "color": "chatText",
              "background": "$none",
              "borderWidth": 0,
              "radius": "$none"
            },
            "control": {
              "chrome": "none",
              "focus": { "kind": "outline", "color": "chatCanvas" }
            },
            "children": [
              "{draft}"
            ]
          },
          {
