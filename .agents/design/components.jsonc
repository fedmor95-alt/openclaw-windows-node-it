                "children": [
                  {
                    "id": "notif-card-glyph-tri",
                    "el": "path",
                    "attrs": {
                      "d": "M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
                    }
                  },
                  {
                    "id": "notif-card-glyph-line",
                    "el": "path",
                    "attrs": {
                      "d": "M12 9v4"
                    }
                  },
                  {
                    "id": "notif-card-glyph-dot",
                    "el": "path",
                    "attrs": {
                      "d": "M12 17h.01"
                    }
                  }
                ]
              },
              {
                "id": "notif-card-text",
