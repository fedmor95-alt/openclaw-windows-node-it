            "margin": { "x": "4", "y": "3" },
            "props": {
              "time": "11:01 PM",
              "usage": "200/128.0K (0%)"
            }
          },
          {
            "id": "chat-thread-composer",
            "component": "ChatComposer"
          }
        ]
      }
    },
