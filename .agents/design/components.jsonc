                  "fontFamily": "body",
                  "textStyle": "body",
                  "color": "accent",
                  "background": "$none",
                  "radius": "sm"
                },
                "control": {
                  "chrome": "none",
                  "focus": { "kind": "outline", "color": "accent" }
                },
                "states": {
                  "hover": { "background": "subtleHover" },
                  "pressed": { "background": "subtlePressed" },
                  "hoverPressed": { "background": "subtlePressed" }
                },
                "children": [
                  "Clear all"
                ]
              }
            ]
          },
          {
            "id": "notif-card",
            "el": "div",
            "layout": {
              "mode": "horizontal",
              "gap": "3",
              "padding": "3",
              "align": "start",
              "width": "fill"
            },
            "appearance": {
              "background": "surface",
              "borderColor": "line",
              "color": "ink",
              "radius": "md"
            },
            "children": [
