    },
    {
      "name": "SetupProgressIndicator",
      "note": "Setup control. The wizard step dots (SetupProgressIndicator.cs). Non-interactive, non-focusable, accessibility-hidden, so no hover/pressed states. The active step is a 20x8 pill in `accent` (SetupIndicatorAccentBrush = SystemAccentColorLight2 dark / Dark1 light); inactive steps are 8x8 dots in `muted` (SetupInactiveDotBrush = ControlStrongFill). Dot spacing is token `2` (8px); every dot uses the `sm` radius (4px).",
      "root": {
        "id": "setup-progress-root",
        "el": "div",
        "attrs": { "role": "img", "aria-label": "Step 2 of 4" },
        "layout": { "mode": "horizontal", "gap": "2", "align": "center" },
        "children": [
          { "id": "setup-progress-d1", "el": "span", "layout": { "width": 8, "height": 8 }, "appearance": { "background": "muted", "radius": "sm" } },
          { "id": "setup-progress-d2", "el": "span", "layout": { "width": 20, "height": 8 }, "appearance": { "background": "accent", "radius": "sm" } },
          { "id": "setup-progress-d3", "el": "span", "layout": { "width": 8, "height": 8 }, "appearance": { "background": "muted", "radius": "sm" } },
          { "id": "setup-progress-d4", "el": "span", "layout": { "width": 8, "height": 8 }, "appearance": { "background": "muted", "radius": "sm" } }
        ]
      }
    },
    {
      "name": "RecommendedBadge",
      "note": "Setup control. The small outlined \"Recommended\" tag beside a capability profile (Controls/RecommendedBadge.xaml). Non-interactive. An outline-only badge: 1px `accent` border (AccentTextFillColorPrimaryBrush), `accent` caption text, no fill, `sm` radius (4px), padding token `2` horizontal and `1` vertical (8,4). Disabled recolors border and text to `muted` (TextFillColorDisabled). This is a small `sm` badge, not the 999px `pill` Badge.",
      "props": {
        "children": "Recommended"
      },
      "root": {
        "id": "recommended-badge-root",
        "el": "span",
        "layout": {
          "mode": "horizontal",
          "align": "center",
          "padding": { "x": "2", "y": "1" },
          "width": "hug"
        },
        "appearance": {
          "fontFamily": "body",
          "textStyle": "caption",
          "color": "accent",
          "background": "$none",
          "borderColor": "accent",
          "radius": "sm"
        },
        "children": [ "{children}" ]
      }
    },
    {
      "name": "ProviderArtwork",
      "note": "Setup control. The square icon tile for an AI provider (Controls/ProviderArtwork.xaml). Non-interactive. A 40x40 tile: `surface` (SolidBackgroundFillColorBase) fill, 1px `line` (CardStrokeColorDefault) border, `sm` radius (ControlCornerRadius), token `2` (8px) padding around a 24x24 glyph or image. Previewed with a representative Segoe Fluent glyph.",
      "root": {
        "id": "provider-artwork-root",
        "el": "span",
        "layout": {
          "mode": "horizontal",
          "align": "center",
          "justify": "center",
          "padding": "2",
          "width": 40,
          "height": 40
        },
        "appearance": {
          "background": "surface",
          "borderColor": "line",
          "radius": "sm"
        },
        "children": [
          {
            "id": "provider-artwork-glyph",
            "el": "span",
            "attrs": {
              "aria-hidden": "true",
              "style": "font-family:'Segoe Fluent Icons','Segoe MDL2 Assets',sans-serif;font-size:24px"
            },
            "appearance": { "color": "ink" },
            "children": [ "\uE99A" ]
          }
        ]
      }
    },
    {
      "name": "SetupOptionCard",
      "note": "Setup composite. A clickable provider/mode choice row (AiSetupPage.xaml compact SettingsCard, IsClickEnabled). Built from the ProviderArtwork tile, a title + detail stack, and a trailing action/chevron. The row itself is transparent with a 1px `line` bottom divider (previewed here via a bottom-biased `line` border; the real card draws only the bottom edge), MinHeight 64px, and `md` radius on the enclosing group. Because it is clickable it carries the SettingsCard subtle states: hover = SubtleFillColorSecondary (`subtleHover`), pressed = SubtleFillColorTertiary (`subtlePressed`); disabled drops text to `muted`. Title is `body` BodyStrong, detail is `caption` in `muted`; the 32px artwork column and 12px gap map to tokens `6`/`3`. There is no XAML-defined selected indicator; selection is tracked by the parent ListView and is a port note.",
      "props": {
        "title": "Sign in with GitHub",
        "detail": "Use your Copilot subscription. No API key needed."
      },
      "root": {
        "id": "setup-option-root",
        "el": "button",
        "attrs": { "type": "button" },
        "layout": {
          "mode": "horizontal",
          "gap": "3",
          "padding": { "x": "4", "y": "3" },
          "align": "center",
          "width": "fill"
        },
        "appearance": {
          "background": "$none",
          "borderColor": "line"
        },
        "control": {
          "chrome": "none",
          "focus": { "kind": "outline", "color": "accent" }
        },
        "states": {
          "hover": { "background": "subtleHover" },
          "pressed": { "background": "subtlePressed" },
          "hoverPressed": { "background": "subtlePressed" },
          "disabled": { "color": "muted", "background": "$none" }
        },
        "children": [
          { "id": "setup-option-art", "component": "ProviderArtwork" },
          {
            "id": "setup-option-text",
            "el": "div",
            "layout": { "mode": "vertical", "gap": "1", "grow": true, "width": "fill" },
            "children": [
              { "id": "setup-option-title", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "body", "color": "ink" }, "children": [ "{title}" ] },
              { "id": "setup-option-detail", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted" }, "children": [ "{detail}" ] }
            ]
          },
          {
            "id": "setup-option-chevron",
            "el": "span",
            "attrs": {
              "aria-hidden": "true",
              "style": "font-family:'Segoe Fluent Icons','Segoe MDL2 Assets',sans-serif;font-size:12px"
            },
            "appearance": { "color": "muted" },
            "children": [ "\uE76C" ]
          }
        ]
      }
    },
    {
      "name": "CapabilityOptionRow",
      "note": "Setup composite. A single capability-profile choice (CapabilitiesPage.xaml ListViewItem). Rows live inside a `surface` group with a 1px `line` border and `md` radius; each row is padded token `4` horizontal and `3` vertical (16,12) with a title (`body` BodyStrong) over a wrapping `caption` description in `muted`, and the recommended profile carries the RecommendedBadge. Single-selection follows focus; because it is selectable it shows the Fluent ListViewItem states: hover = SubtleFillColorSecondary (`subtleHover`), pressed = SubtleFillColorTertiary (`subtlePressed`); the selected row's accent pill/left bar is a WinUI ListViewItem template part and is a port note (no custom setter in setup XAML).",
      "props": {
        "title": "Balanced",
        "detail": "Recommended defaults for most Windows nodes."
      },
      "root": {
        "id": "capability-row-root",
        "el": "button",
        "attrs": { "type": "button", "role": "option" },
        "layout": {
          "mode": "horizontal",
          "gap": "2",
          "padding": { "x": "4", "y": "3" },
          "align": "center",
          "width": "fill"
        },
        "appearance": {
          "background": "$none",
          "radius": "sm"
        },
        "control": {
          "chrome": "none",
          "focus": { "kind": "outline", "color": "accent" }
        },
        "states": {
          "hover": { "background": "subtleHover" },
          "pressed": { "background": "subtlePressed" },
          "hoverPressed": { "background": "subtlePressed" }
        },
        "children": [
          {
            "id": "capability-row-text",
            "el": "div",
            "layout": { "mode": "vertical", "gap": "1", "grow": true, "width": "fill" },
            "children": [
              { "id": "capability-row-title", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "body", "color": "ink" }, "children": [ "{title}" ] },
              { "id": "capability-row-detail", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted" }, "children": [ "{detail}" ] }
            ]
          },
          { "id": "capability-row-badge", "component": "RecommendedBadge" }
        ]
      }
    },
    {
      "name": "SetupPhaseStatus",
      "note": "Setup control. The inline phase result row (Controls/SetupPhaseStatus.xaml). Non-interactive. A horizontal row, token `2` (8px) gap, pairing a status indicator with `caption` text (max width 160px) in `muted`. Running shows a 20x20 ProgressRing; Complete shows the Segoe Fluent StatusOk check (U+E73E) in `positive` (SystemFillColorSuccess); Failed shows StatusErr (U+EA39) in `critical` (SystemFillColorCritical); Cancelled shows Exit (U+E711) in `muted`. Previewed in the Complete state.",
      "props": {
        "children": "Gateway connected"
      },
      "root": {
        "id": "setup-phase-root",
        "el": "div",
        "attrs": { "role": "status" },
        "layout": { "mode": "horizontal", "gap": "2", "align": "center" },
        "children": [
          {
            "id": "setup-phase-glyph",
            "el": "span",
            "attrs": {
              "aria-hidden": "true",
              "style": "font-family:'Segoe Fluent Icons','Segoe MDL2 Assets',sans-serif;font-size:16px"
            },
            "appearance": { "color": "positive" },
            "children": [ "\uE73E" ]
          },
          {
            "id": "setup-phase-text",
            "el": "span",
            "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted" },
            "children": [ "{children}" ]
          }
        ]
      }
    },
    {
      "name": "SetupWizardShell",
      "note": "Setup composite. The onboarding wizard frame (Pages/WizardPage.xaml). A vertical page: a header (mascot + `title` TitleTextBlockStyle headline + `caption` status in `muted`), the active step surface, and a footer. Page padding is 40,4,40,24 (previewed with token `6` horizontal and `1`/`5` vertical; the 40px horizontals are off-grid port notes). The step card is a `surface` sheet with a 1px `line` border, `md` radius, and token `5` (24px) padding; its MinHeight (180/140/200/260) is a runtime port note. The footer places a standard (secondary) Button and the accent (primary) Button on the ends with the SetupProgressIndicator centered; footer column gap is token `2`. Composes Button and SetupProgressIndicator.",
      "root": {
        "id": "setup-wizard-root",
        "el": "section",
        "layout": {
          "mode": "vertical",
          "gap": "5",
          "padding": { "left": "6", "right": "6", "top": "1", "bottom": "5" },
          "width": "fill"
        },
        "appearance": { "background": "paper" },
        "children": [
          {
            "id": "setup-wizard-header",
            "el": "div",
            "layout": { "mode": "vertical", "gap": "1", "align": "center" },
            "children": [
              { "id": "setup-wizard-title", "el": "h1", "appearance": { "fontFamily": "display", "textStyle": "title", "color": "ink", "textAlign": "center" }, "children": [ "Set up your Windows node" ] },
              { "id": "setup-wizard-status", "el": "p", "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted", "textAlign": "center" }, "children": [ "Step 2 of 4 · Choose capabilities" ] }
            ]
          },
          {
            "id": "setup-wizard-card",
            "el": "div",
            "layout": { "mode": "vertical", "gap": "4", "padding": "5", "width": "fill" },
            "appearance": { "background": "surface", "borderColor": "line", "radius": "md" },
            "children": [
              { "id": "setup-wizard-card-title", "el": "h2", "appearance": { "fontFamily": "display", "textStyle": "subtitle", "color": "ink" }, "children": [ "Choose what this node can do" ] },
              { "id": "setup-wizard-opt-1", "component": "CapabilityOptionRow" },
              {
                "id": "setup-wizard-opt-2",
                "component": "CapabilityOptionRow",
                "props": { "title": "Full access", "detail": "Expose every capability over MCP." }
              }
            ]
          },
          {
            "id": "setup-wizard-footer",
            "el": "div",
            "layout": { "mode": "horizontal", "gap": "2", "align": "center", "justify": "space-between", "width": "fill" },
            "children": [
              { "id": "setup-wizard-back", "component": "Button", "props": { "children": "Back", "variant": "standard" } },
              { "id": "setup-wizard-progress", "component": "SetupProgressIndicator" },
              { "id": "setup-wizard-next", "component": "Button", "props": { "children": "Continue", "variant": "primary" } }
            ]
          }
        ]
      }
    },
    {
      "name": "SettingsSectionHeader",
      "note": "Settings control. The group label above a stack of settings cards (used across SettingsPage / PermissionsPage / SandboxPage). Non-interactive. `body` BodyStrongTextBlockStyle in `ink`, with margin 4,18,4,4 (previewed as token `1` sides, `4` top, `1` bottom; the 18px top is off-grid and a port note).",
      "props": { "children": "Permissions" },
      "root": {
        "id": "settings-section-header-root",
        "el": "h2",
        "margin": { "top": "4", "right": "1", "bottom": "1", "left": "1" },
        "appearance": { "fontFamily": "body", "textStyle": "body", "color": "ink" },
        "children": [ "{children}" ]
      }
    },
    {
      "name": "SettingsCard",
      "note": "Settings composite. The canonical settings row (hand-rolled Border, not the toolkit SettingsCard). STATIC: the card itself has no hover/pressed; the trailing control owns interaction. A `surface`-less `paper` Border with a 1px `line` (CardStrokeColorDefault) stroke, `md` radius (8px), and token `4` (16px) padding (some cards use 16,14; the 14 is off-grid). Layout is an optional 36px leading icon column, a growing content column (title `body` BodyStrong in `ink` over a wrapping `caption` description in `muted`), and a trailing Auto control column. Cards stack with token `2` (8px) spacing.",
      "props": {
        "title": "Startup",
        "detail": "Launch OpenClaw when you sign in to Windows."
      },
      "root": {
        "id": "settings-card-root",
        "el": "div",
        "layout": { "mode": "horizontal", "gap": "3", "padding": "4", "align": "center", "width": "fill" },
        "appearance": { "background": "paper", "borderColor": "line", "radius": "md" },
        "children": [
          {
            "id": "settings-card-icon",
            "el": "span",
            "attrs": {
              "aria-hidden": "true",
              "style": "font-family:'Segoe Fluent Icons','Segoe MDL2 Assets',sans-serif;font-size:16px"
            },
            "layout": { "mode": "horizontal", "align": "center", "justify": "center", "width": 36 },
            "appearance": { "color": "ink" },
            "children": [ "\uE7E8" ]
          },
          {
            "id": "settings-card-text",
            "el": "div",
            "layout": { "mode": "vertical", "gap": "1", "grow": true, "width": "fill" },
            "children": [
              { "id": "settings-card-title", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "body", "color": "ink" }, "children": [ "{title}" ] },
              { "id": "settings-card-detail", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted" }, "children": [ "{detail}" ] }
            ]
          },
          { "id": "settings-card-action", "component": "Button", "props": { "children": "Change", "variant": "standard" } }
        ]
      }
    },
    {
      "name": "SettingsToggleRow",
      "note": "Settings composite. A SettingsCard whose trailing control is the Fluent ToggleSwitch (the most common settings row). Same static `paper` card: 1px `line` stroke, `md` radius, token `4` padding, token `1` title/detail stack. The ToggleSwitch owns the hover/pressed states (see ToggleSwitch); the card is static. Composes ToggleSwitch.",
      "props": {
        "title": "Run at startup",
        "detail": "Start the OpenClaw tray automatically."
      },
      "root": {
        "id": "settings-toggle-root",
        "el": "div",
        "layout": { "mode": "horizontal", "gap": "3", "padding": "4", "align": "center", "width": "fill" },
        "appearance": { "background": "paper", "borderColor": "line", "radius": "md" },
        "children": [
          {
            "id": "settings-toggle-text",
            "el": "div",
            "layout": { "mode": "vertical", "gap": "1", "grow": true, "width": "fill" },
            "children": [
              { "id": "settings-toggle-title", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "body", "color": "ink" }, "children": [ "{title}" ] },
              { "id": "settings-toggle-detail", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted" }, "children": [ "{detail}" ] }
            ]
          },
          { "id": "settings-toggle-switch", "component": "ToggleSwitch" }
        ]
      }
    },
    {
      "name": "SettingsExpanderRow",
      "note": "Settings composite. An expandable settings group built on the stock WinUI Expander (SandboxPage.xaml), not the toolkit SettingsExpander. The header is an interactive row (ColumnSpacing 14, previewed token `3`; header padding 0,4) with an optional leading icon, a growing title (`body` BodyStrong) over `caption` description, and a trailing chevron (U+E70D) that rotates when open. The header carries stock Expander subtle states: hover = SubtleFillColorSecondary (`subtleHover`), pressed = SubtleFillColorTertiary (`subtlePressed`). The expanded content is a StackPanel, token `3` (12px) spacing, padding 0,4. Previewed expanded.",
      "props": {
        "title": "Advanced sandbox",
        "detail": "Fine-tune the command execution sandbox."
      },
      "root": {
        "id": "settings-expander-root",
        "el": "div",
        "layout": { "mode": "vertical", "width": "fill" },
        "appearance": { "background": "paper", "borderColor": "line", "radius": "md" },
        "children": [
          {
            "id": "settings-expander-header",
            "el": "button",
            "attrs": { "type": "button", "aria-expanded": "true" },
            "layout": { "mode": "horizontal", "gap": "3", "padding": { "x": "4", "y": "3" }, "align": "center", "width": "fill" },
            "appearance": { "background": "$none", "radius": "md" },
            "control": {
              "chrome": "none",
              "focus": { "kind": "outline", "color": "accent" }
            },
            "states": {
              "hover": { "background": "subtleHover" },
              "pressed": { "background": "subtlePressed" },
              "hoverPressed": { "background": "subtlePressed" }
            },
            "children": [
              {
                "id": "settings-expander-text",
                "el": "div",
                "layout": { "mode": "vertical", "gap": "1", "grow": true, "width": "fill" },
                "children": [
                  { "id": "settings-expander-title", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "body", "color": "ink" }, "children": [ "{title}" ] },
                  { "id": "settings-expander-detail", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "caption", "color": "muted" }, "children": [ "{detail}" ] }
                ]
              },
              {
                "id": "settings-expander-chevron",
                "el": "span",
                "attrs": {
                  "aria-hidden": "true",
                  "style": "font-family:'Segoe Fluent Icons','Segoe MDL2 Assets',sans-serif;font-size:12px"
                },
                "appearance": { "color": "muted" },
                "children": [ "\uE70D" ]
              }
            ]
          },
          {
            "id": "settings-expander-content",
            "el": "div",
            "layout": { "mode": "vertical", "gap": "3", "padding": { "x": "4", "y": "3" }, "width": "fill" },
            "children": [
              { "id": "settings-expander-child", "component": "SettingsToggleRow", "props": { "title": "Allow network access", "detail": "Let sandboxed commands reach the network." } }
            ]
          }
        ]
      }
    },
    {
      "name": "SettingsWindowShell",
      "note": "Settings composite. The Settings host window frame (Windows/HubWindow.xaml). MinWidth 1000, Mica backdrop, title bar captioned \"OpenClaw Settings\". A left NavigationView rail (pane toggle and the stock settings item hidden) sits beside a scrolling content column padded token `5` (24px) with a MaxWidth of 900px (port note). The bottom of the window hosts a 40px status pill and a 40x40 toolbar button cluster. Composes SettingsSectionHeader and SettingsToggleRow; the nav items reuse the subtle-button interaction model.",
      "root": {
        "id": "settings-window-root",
        "el": "section",
        "layout": { "mode": "horizontal", "width": "fill" },
        "appearance": { "background": "paper" },
        "children": [
          {
            "id": "settings-window-nav",
            "el": "nav",
            "layout": { "mode": "vertical", "gap": "1", "padding": "2", "width": 240 },
            "appearance": { "background": "surface", "borderColor": "line" },
            "children": [
              {
                "id": "settings-window-nav-general",
                "el": "button",
                "attrs": { "type": "button", "aria-current": "page" },
                "layout": { "mode": "horizontal", "gap": "2", "padding": { "x": "2", "y": "2" }, "align": "center", "width": "fill" },
                "appearance": { "background": "subtleHover", "radius": "sm", "color": "ink" },
                "control": { "chrome": "none", "focus": { "kind": "outline", "color": "accent" } },
                "states": {
                  "hover": { "background": "subtleHover" },
                  "pressed": { "background": "subtlePressed" },
                  "hoverPressed": { "background": "subtlePressed" }
                },
                "children": [
                  { "id": "settings-window-nav-general-glyph", "el": "span", "attrs": { "aria-hidden": "true", "style": "font-family:'Segoe Fluent Icons','Segoe MDL2 Assets',sans-serif;font-size:16px" }, "appearance": { "color": "ink" }, "children": [ "\uE713" ] },
                  { "id": "settings-window-nav-general-label", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "body", "color": "ink" }, "children": [ "General" ] }
                ]
              },
              {
                "id": "settings-window-nav-perms",
                "el": "button",
                "attrs": { "type": "button" },
                "layout": { "mode": "horizontal", "gap": "2", "padding": { "x": "2", "y": "2" }, "align": "center", "width": "fill" },
                "appearance": { "background": "$none", "radius": "sm", "color": "ink" },
                "control": { "chrome": "none", "focus": { "kind": "outline", "color": "accent" } },
                "states": {
                  "hover": { "background": "subtleHover" },
                  "pressed": { "background": "subtlePressed" },
                  "hoverPressed": { "background": "subtlePressed" }
                },
                "children": [
                  { "id": "settings-window-nav-perms-glyph", "el": "span", "attrs": { "aria-hidden": "true", "style": "font-family:'Segoe Fluent Icons','Segoe MDL2 Assets',sans-serif;font-size:16px" }, "appearance": { "color": "ink" }, "children": [ "\uE72E" ] },
                  { "id": "settings-window-nav-perms-label", "el": "span", "appearance": { "fontFamily": "body", "textStyle": "body", "color": "ink" }, "children": [ "Permissions" ] }
                ]
              }
            ]
          },
          {
            "id": "settings-window-content",
            "el": "div",
            "layout": { "mode": "vertical", "gap": "2", "padding": "5", "grow": true, "width": "fill" },
            "children": [
              { "id": "settings-window-section", "component": "SettingsSectionHeader", "props": { "children": "General" } },
              { "id": "settings-window-row-1", "component": "SettingsToggleRow" },
              { "id": "settings-window-row-2", "component": "SettingsExpanderRow" }
            ]
          }
        ]
      }
    },
    {
      "name": "ExampleScreen",
      "note": "A representative Connection screen composed from the pieces above — the \"does it hang together\" check for the whole system. The status board is a freeform layer so the two cards can overlap into a Fluent-style dashboard, exercising v3 absolute positioning alongside Auto Layout.",
      "root": {
        "id": "example-screen-root",
        "el": "section",
        "class": "ds-screen",
        "layout": {
          "mode": "vertical",
          "gap": "5",
          "width": "fill"
        },
        "children": [
          {
            "id": "example-screen-head",
            "el": "header",
            "class": "ds-screen-head",
            "layout": {
              "mode": "horizontal",
              "gap": "4",
              "align": "start",
              "justify": "space-between",
              "width": "fill"
            },
            "children": [
              {
                "id": "example-screen-heading",
                "el": "div",
                "layout": {
                  "mode": "vertical",
                  "gap": "1"
                },
                "children": [
                  {
                    "id": "example-screen-eyebrow",
                    "el": "p",
                    "class": "ds-eyebrow",
                    "children": [
                      "Connection"
                    ]
                  },
                  {
                    "id": "example-screen-title",
                    "el": "h2",
                    "class": "ds-screen-title",
                    "children": [
                      "OpenClaw Windows Hub"
                    ]
                  }
                ]
              },
              {
                "id": "example-screen-status",
                "component": "Badge",
                "props": {
                  "tone": "positive",
                  "children": "Connected"
                }
              }
            ]
          },
          {
            "id": "example-screen-board",
            "el": "div",
            "class": "ds-grid",
            "layout": {
              "mode": "horizontal",
              "width": "fill",
              "height": 176,
              "gap": "3"
            },
            "children": [
              {
                "id": "example-screen-gateway",
                "component": "Card",
                "props": {
                  "title": "Gateway",
                  "body": "Paired to OpenClawGateway · last seen just now."
                },
                "layout": {
                  "width": 280,
                  "height": 148
                }
              },
              {
                "id": "example-screen-node",
                "component": "Card",
                "props": {
                  "title": "Windows node",
                  "body": "6 capabilities exposed over MCP."
                },
                "layout": {
                  "width": 280,
                  "height": 148
                }
              }
            ]
          },
          {
            "id": "example-screen-row",
            "el": "div",
            "class": "ds-row",
            "layout": {
              "mode": "horizontal",
              "gap": "4",
              "align": "end",
              "wrap": true,
              "width": "fill"
            },
            "children": [
              {
                "id": "example-screen-field",
                "component": "Field",
                "props": {
                  "label": "Gateway address",
                  "placeholder": "127.0.0.1:18789"
                },
                "layout": {
                  "grow": true
                }
              },
              {
                "id": "example-screen-connect",
                "component": "Button",
                "props": {
                  "children": "Connect",
                  "variant": "primary"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
